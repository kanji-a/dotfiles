# シェルのキー操作をvim化
bindkey -v
# 履歴を使う
export HISTFILE=${HOME}/.zsh_history
# 検索可能な履歴数
export HISTSIZE=1000
# 履歴ファイルに保存される履歴の件数
export SAVEHIST=100000
# 履歴の重複を排除
setopt hist_ignore_all_dups
# 履歴を別タブでも共有
setopt share_history
# NeoVimをデフォルトエディタにする
export EDITOR=nvim
# asdfを使用する
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
# Linuxbrewに必要
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
# Starship起動
eval "$(starship init zsh)"
# Sheldon 読み込み
eval "$(sheldon source)"
# fzf 有効化
# zsh-vi-mode とコマンドが競合するので後に実行されるようにする
# https://github.com/jeffreytse/zsh-vi-mode?tab=readme-ov-file#execute-extra-commands
# ghqで管理してるリポジトリをAlt-Cで検索してcdする
export FZF_ALT_C_COMMAND='ghq list --full-path'
zvm_after_init_commands+=('source <(fzf --zsh)')
# completeコマンドを使うために必要
autoload bashcompinit && bashcompinit
# 補完機能compsys有効化
autoload -Uz compinit && compinit
# zsh-vi-mode のエスケープキーの割当
export ZVM_VI_INSERT_ESCAPE_BINDKEY=jj
